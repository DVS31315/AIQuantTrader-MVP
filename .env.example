# Local application
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=./data/agent.db

# Bybit public market data only — no API keys and no order endpoints
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_CATEGORY=linear
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=15
CANDLE_LIMIT=200
MARKET_POLL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=12

# LLM: ollama (default) or openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Paper account and risk controls
STARTING_EQUITY=10000
RISK_PER_TRADE_PCT=0.5
CRYPTO_MAX_LEVERAGE=3
FOREX_MAX_LEVERAGE=5
METALS_MAX_LEVERAGE=5
TAKER_FEE_PCT=0.055
SLIPPAGE_PCT=0.02

# Comma-separated RSS feeds; failed feeds are logged and excluded from model context
NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/
NEWS_LIMIT=12
NEWS_TIMEOUT_SECONDS=8
